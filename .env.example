# ─────────────────────────────────────────
# drive-pipeline — required environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────

# Google Gemini API key (embeddings + Vision OCR)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

HF_TOKEN=your_hugging_face_token

MODEL_CACHE_DIR=
# Root watch directory — subfolders originals/ processing/ failed/ live here
# Default: ~/Documents/toDrive
WATCH_DIR=~/Documents/toDrive

# ChromaDB local persistence directory
# Default: ~/.drive-pipeline/chroma
CHROMA_PERSIST_DIR=~/.drive-pipeline/chroma

# Optional: force one Chroma collection name.
# By default, the collection name is derived from EMBEDDING_MODEL so changing
# models does not mix incompatible embedding dimensions.
CHROMA_COLLECTION_NAME=

# SQLite job-queue database path
# Default: ~/.drive-pipeline/jobs.db
SQLITE_DB_PATH=~/.drive-pipeline/jobs.db
